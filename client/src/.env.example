# BLEE Quant Pro Trader — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your secrets.

# ── Schwab API Credentials ─────────────────────────────────────────────────────
# Get these from developer.schwab.com → My Apps
SCHWAB_API_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Your Schwab brokerage account number (8-digit number on your statements)
SCHWAB_ACCOUNT_NUMBER=12345678

# Any passphrase you choose — used to encrypt your Schwab token file at rest
SCHWAB_TOKEN_PASSPHRASE=choose_a_secure_passphrase

# ── Optional Settings ──────────────────────────────────────────────────────────
# OAuth callback URL — must match what you registered in your Schwab app
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Port for the weekly re-auth server (must match SCHWAB_CALLBACK_URL port)
SCHWAB_AUTH_PORT=8182

# Encrypted token file name (stored in the src/ folder)
SCHWAB_TOKEN_FILE=schwab_token.enc

# Your total portfolio budget for rebalancing (dollars)
PORTFOLIO_VALUE=10000.00

# Flask session secret — auto-generated if not set, but setting it makes
# sessions survive app restarts without forcing re-login
BLEE_CLIENT_SECRET=
